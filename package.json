{
  "name": "tankwarfare",
  "version": "1.0.0",
  "description": "Build a tank block by block, then drive it into a third-person armoured battle. Three.js, no build step.",
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8099",
    "check": "bash tools/check.sh",
    "shots": "node tools/shoot.mjs",
    "sim": "node tools/sim.mjs",
    "soak": "node tools/soak.mjs"
  },
  "keywords": ["threejs", "webgl", "game", "tank", "voxel"],
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.49.1",
    "pngjs": "^7.0.0"
  }
}
